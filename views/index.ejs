<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Emmeril Hotspot | Internet Cepat & Stabil</title>
    <link rel="icon" href="/img/favicon.png" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <nav class="navbar navbar-expand-lg site-navbar fixed-top">
      <div class="container">
        <a class="navbar-brand" href="#home" aria-label="Emmeril Hotspot">
          <span class="brand-mark">
            <img
              src="https://voucher.emmeril-hotspot.online/assets/img/logo.png"
              alt=""
            />
          </span>
          <span>Emmeril Hotspot</span>
        </a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto align-items-lg-center">
            <li class="nav-item"><a class="nav-link" href="#coverage">Coverage</a></li>
            <li class="nav-item"><a class="nav-link" href="#info">Info</a></li>
            <li class="nav-item ms-lg-3">
              <a
                class="btn btn-primary-soft"
                href="https://voucher.emmeril-hotspot.online"
                target="_blank"
                rel="noopener"
              >
                <i class="bi bi-bag-check"></i>
                Beli Voucher
              </a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <header id="home" class="hero-section">
      <div class="hero-watermark">WiFi</div>
      <div class="container">
        <div class="row align-items-center g-5">
          <div class="col-lg-6">
            <p class="eyebrow">WiFi hotspot untuk rumah, kos, dan usaha</p>
            <h1>Internet cepat, stabil, dan mudah diakses di semua titik.</h1>
            <p class="hero-copy">
              Nikmati koneksi yang nyaman untuk kerja, belajar, streaming,
              gaming, dan transaksi harian dengan voucher yang bisa dibeli
              online.
            </p>
            <div class="hero-actions">
              <a
                href="https://voucher.emmeril-hotspot.online"
                target="_blank"
                rel="noopener"
                class="btn btn-primary-soft btn-lg"
              >
                <i class="bi bi-cart-check"></i>
                Beli Sekarang
              </a>
              <a href="#coverage" class="btn btn-outline-blue btn-lg">
                <i class="bi bi-geo-alt"></i>
                Lihat Coverage
              </a>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="hero-panel">
              <div class="signal-card">
                <div class="signal-icon">
                  <i class="bi bi-router"></i>
                </div>
                <div>
                  <span>Status Layanan</span>
                  <strong>Aktif & Stabil</strong>
                </div>
              </div>
              <div class="hero-metrics">
                <div>
                  <strong>24/7</strong>
                  <span>Akses hotspot</span>
                </div>
                <div>
                  <strong>Online</strong>
                  <span>Pembelian voucher</span>
                </div>
                <div>
                  <strong>Multi</strong>
                  <span>Titik koneksi</span>
                </div>
              </div>
              <div class="coverage-preview">
                <img src="/img/coverage-map.jpeg" alt="Pratinjau peta coverage" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main>
      <section id="coverage" class="section-block coverage-section">
        <div class="container">
          <div class="section-heading text-center">
            <p class="section-kicker">Coverage Area</p>
            <h2>Jangkauan koneksi Emmeril Hotspot</h2>
            <p>
              Cek area jangkauan WiFi hotspot kami melalui peta berikut agar
              lebih mudah memilih titik akses terdekat.
            </p>
          </div>
          <div class="map-frame">
            <img
              src="/img/coverage-map.jpeg"
              alt="Peta Coverage Area Emmeril Hotspot"
            />
          </div>
        </div>
      </section>

      <section id="info" class="section-block benefit-section">
        <div class="container">
          <div class="section-heading">
            <p class="section-kicker">Informasi Penting</p>
            <h2>Layanan yang siap dipakai tanpa ribet</h2>
          </div>

          <div class="row g-4">
            <div class="col-md-4 d-flex">
              <article class="benefit-card">
                <div class="benefit-icon"><i class="bi bi-cart-check"></i></div>
                <h3>Beli Voucher Hotspot</h3>
                <p>
                  Dapatkan voucher hotspot secara online dengan proses yang
                  cepat, praktis, dan aman.
                </p>
                <a
                  href="https://voucher.emmeril-hotspot.online"
                  target="_blank"
                  rel="noopener"
                >
                  Beli Sekarang
                </a>
              </article>
            </div>
            <div class="col-md-4 d-flex">
              <article class="benefit-card">
                <div class="benefit-icon"><i class="bi bi-stars"></i></div>
                <h3>Fitur Hotspot</h3>
                <ul class="feature-list">
                  <li><i class="bi bi-speedometer2"></i>Kecepatan stabil untuk streaming dan gaming</li>
                  <li><i class="bi bi-shield-lock"></i>Koneksi aman dan terenkripsi</li>
                  <li><i class="bi bi-phone"></i>Akun dapat otomatis terkoneksi di semua titik</li>
                  <li><i class="bi bi-cash-coin"></i>Harga hemat mulai dari seribu</li>
                </ul>
              </article>
            </div>
            <div class="col-md-4 d-flex">
              <article class="benefit-card">
                <div class="benefit-icon"><i class="bi bi-headset"></i></div>
                <h3>Customer Service</h3>
              <p>
                  Ingin pasang WiFi Emmeril Hotspot di rumah, kos, atau usaha?
                  Tim kami siap membantu kebutuhan Anda.
              </p>
                <a
                  href="https://wa.me/6287728972090"
                  target="_blank"
                  rel="noopener"
                >
                  Chat WhatsApp
                </a>
              </article>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-brand">
          <img
            src="https://voucher.emmeril-hotspot.online/assets/img/logo.png"
            alt=""
          />
          <div>
            <strong>Emmeril Hotspot</strong>
            <span>Internet Cepat & Stabil</span>
          </div>
        </div>
        <p>&copy; <%= new Date().getFullYear() %> Emmeril@Hotspot</p>
        <p>Internet Cepat & Stabil</p>
      </div>
    </footer>

    <a
      class="floating-whatsapp"
      href="https://wa.me/6287728972090"
      target="_blank"
      rel="noopener"
      aria-label="Chat WhatsApp Emmeril Hotspot"
    >
      <i class="bi bi-whatsapp"></i>
    </a>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/script.js"></script>
  </body>
</html>
